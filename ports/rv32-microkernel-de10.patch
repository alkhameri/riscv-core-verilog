+#include "vm.h"
+#include "common.h"
+
+// The DE10-Lite port runs this kernel in M mode with physical addresses.
+// PMP is available for future user tasks; Sv32 and S mode are not implemented.
+void vm_init(void) {}
+void vm_map_identity(uintptr_t start, uintptr_t end) {
